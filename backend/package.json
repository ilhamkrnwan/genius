{
  "name": "@genius-unu/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "db:seed:maba": "bun run scripts/seed_maba_2026.ts",
    "db:seed:official": "bun run scripts/seed_official_quiz.ts",
    "db:seed:quiz": "bun run scripts/seed_genius_2026_quiz.ts",
    "db:repair:ormawa-pics": "bun run src/db/ensure-ormawa-pics.ts",
    "test": "bun test",
    "test:integration": "bun test tests/api-integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.3.1",
    "@genius/types": "workspace:*",
    "drizzle-orm": "^0.39.0",
    "elysia": "^1.2.0",
    "jose": "^5.9.6",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
