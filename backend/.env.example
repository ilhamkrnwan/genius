# Database
DATABASE_URL=postgres://genius:genius2026@localhost:5432/genius_2026
DB_MAX_CONNECTIONS=25

# JWT
JWT_SECRET=genius-2026-super-secret-key-local-development
JWT_EXPIRES_IN=24h

# Server
PORT=3001
HOST=0.0.0.0

# Campus Wi-Fi NAT Mode (scaled rate limits for thousands of students on single IP)
CAMPUS_NAT_MODE=false

# AI Gateway & LLM Engine (Google Gemini / Groq / OpenRouter)
# Multi-key didukung (dipisah koma atau GEMINI_API_KEY_1, _2) untuk auto-rotation & rate limit bypass
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# AI Performance & Concurrency Tuning
AI_MAX_CONCURRENCY=2
AI_CACHE_TTL_MINUTES=180
